[Unit]
Description=AstraG Control Panel and IPTV Streaming Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astrag
Group=astrag
WorkingDirectory=/var/lib/astrag
Environment="MALLOC_MMAP_THRESHOLD_=1048576"
Environment="MALLOC_TRIM_THRESHOLD_=131072"
Environment="MALLOC_ARENA_MAX=2"
Environment="ASTRA_CONFIG_FILE=/etc/astrag/astrag.conf"
ExecStart=/usr/bin/astrag -c /etc/astrag/astrag.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
StateDirectory=astrag
StateDirectoryMode=0750
ConfigurationDirectory=astrag
ConfigurationDirectoryMode=0750
UMask=0027
StandardOutput=journal
StandardError=journal
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/astrag /var/lib/astrag
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
